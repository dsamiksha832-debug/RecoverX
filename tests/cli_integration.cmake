if(NOT DEFINED RECOVERX_EXE)
    message(FATAL_ERROR "RECOVERX_EXE was not provided")
endif()

set(test_root "${CMAKE_CURRENT_BINARY_DIR}/recoverx cli integration test")
file(REMOVE_RECURSE "${test_root}")
file(MAKE_DIRECTORY "${test_root}")
set(source "${test_root}/sample file.bin")
set(store "${test_root}/backup store")
set(output "${test_root}/restored file.bin")
set(original "RecoverX original file with several chunks.")
set(edited "RecoverX edited file with several chunks.")
file(WRITE "${source}" "${original}")

execute_process(COMMAND "${RECOVERX_EXE}" --help RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "recoverx --help failed: ${result}")
endif()

execute_process(COMMAND "${RECOVERX_EXE}" backup "${source}" "${store}" 8 RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "first backup failed: ${result}")
endif()
execute_process(COMMAND "${RECOVERX_EXE}" history "${source}" "${store}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "history failed: ${result}")
endif()
execute_process(COMMAND "${RECOVERX_EXE}" list "${source}" "${store}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "list failed: ${result}")
endif()
execute_process(COMMAND "${RECOVERX_EXE}" verify 1 "${store}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "verification of version 1 failed: ${result}")
endif()
execute_process(COMMAND "${RECOVERX_EXE}" verify "${source}" 1 "${store}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "file-scoped verification of version 1 failed: ${result}")
endif()

file(WRITE "${source}" "${edited}")
execute_process(COMMAND "${RECOVERX_EXE}" backup "${source}" "${store}" 8 RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "second backup failed: ${result}")
endif()
execute_process(COMMAND "${RECOVERX_EXE}" corrupt "${source}" 2 bitflip "${store}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "chunk corruption failed: ${result}")
endif()
execute_process(COMMAND "${RECOVERX_EXE}" verify 2 "${store}" RESULT_VARIABLE result)
if(result EQUAL 0)
    message(FATAL_ERROR "corrupted version 2 unexpectedly verified")
endif()

execute_process(COMMAND "${RECOVERX_EXE}" recover "${source}" "${store}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "recovery failed: ${result}")
endif()
file(READ "${source}" recovered)
if(NOT recovered STREQUAL original)
    message(FATAL_ERROR "recovery did not restore the original contents")
endif()

execute_process(COMMAND "${RECOVERX_EXE}" restore 1 "${output}" "${store}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "explicit restore failed: ${result}")
endif()
file(READ "${output}" restored)
if(NOT restored STREQUAL original)
    message(FATAL_ERROR "explicit restore produced incorrect contents")
endif()

execute_process(COMMAND "${RECOVERX_EXE}" undo "${source}" "${store}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "undo failed: ${result}")
endif()
file(READ "${source}" undone)
if(NOT undone STREQUAL original)
    message(FATAL_ERROR "undo did not restore the previous contents")
endif()

file(REMOVE_RECURSE "${test_root}")
message(STATUS "CLI integration test passed")
